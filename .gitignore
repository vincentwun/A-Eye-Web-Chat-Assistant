# Local .terraform directories (contains downloaded providers and modules)
**/.terraform/*

# State files (CRITICAL: Contains sensitive data/secrets; never commit to Git)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files (often contain secrets; keep *.tfvars.example as a template)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Saved plan files (can contain sensitive variables)
*.tfplan

# React + TypeScript + Node.js
# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
build/
dist/
out/
.output/
.wxt/

# TypeScript build cache
*.tsbuildinfo

# Environment variable files (contain API keys and secrets)
.env
.env.*
!.env.example

# Test coverage reports
coverage/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

docs/temp/
